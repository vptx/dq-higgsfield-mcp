# ── Higgsfield API (console.higgsfield.ai → API keys). Stays on the server only. ──
HF_CREDENTIALS=YOUR_KEY_ID:YOUR_KEY_SECRET
HF_BASE_URL=https://api.higgsfield.ai
# Optional: shorter upstream retention, e.g. 24h (min 1h). Empty = Higgsfield default (7 days).
HF_EXPIRES_AFTER=

# ── ElevenLabs (elevenlabs.io → API keys). Empty = service off. Needs ARCHIVE_DIR + FILES_SECRET for audio links. ──
ELEVENLABS_API_KEY=
# Per-request text cap for text-to-speech
ELEVENLABS_MAX_CHARS=5000

# ── Server ──
PORT=8787
HOST=0.0.0.0
# Your public HTTPS address (used in connector URLs and download links)
PUBLIC_BASE_URL=https://hf.big-system.app

# ── Storage ──
DB_PATH=./data/bc-higgsfield.sqlite
MODELS_FILE=./models.json
# Finished outputs are copied here (Higgsfield deletes its copies after ~7 days). Empty = off.
ARCHIVE_DIR=./data/outputs
# 32+ random chars. Generate with:  openssl rand -base64 48
FILES_SECRET=
FILE_LINK_TTL_DAYS=30

# ── Limits ──
# Higgsfield allows 20 concurrent requests per key; keep headroom.
GLOBAL_CONCURRENCY=18
DEFAULT_USER_CONCURRENCY=3
DEFAULT_MONTHLY_BUDGET_USD=50
# Hard ceiling for the whole team per month in USD (0 = off)
ORG_MONTHLY_BUDGET_USD=300
ALLOW_CUSTOM_MODELS_FOR_ADMINS=true

# ── Behaviour ──
POLL_INTERVAL_MS=10000
MAX_WAIT_SECONDS=50
STALE_AFTER_HOURS=6
LOG_LEVEL=info

# ── Admin dashboard (/admin) ──
# 16+ chars. Lets you sign in to /admin before any admin member exists. Empty = admin member tokens only.
ADMIN_PASSWORD=
