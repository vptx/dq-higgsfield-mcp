{
  "name": "bc-higgsfield-mcp",
  "version": "1.0.0",
  "description": "Big Cloud internal MCP gateway for AI services (Higgsfield, ElevenLabs) — per-user service access, budgets, audit log, archived outputs.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server.js",
    "dev": "tsx src/server.ts",
    "admin": "node --no-warnings=ExperimentalWarning dist/admin.js",
    "admin:dev": "tsx src/admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
